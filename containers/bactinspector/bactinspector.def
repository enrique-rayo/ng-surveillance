Bootstrap: docker
From: debian:12.11-slim

%labels
    org.opencontainers.image.title BactInspectorMax
    org.opencontainers.image.version 0.1.3
    org.opencontainers.image.source https://gitlab.com/antunderwood/bactinspector

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install --yes --no-install-recommends \
        mash=2.3+dfsg-3+b1 \
        python3-venv
    python3 -m venv /opt/bactinspector
    /opt/bactinspector/bin/pip install --no-cache-dir \
        pip==23.0.1 \
        setuptools==66.1.1 \
        numpy==1.23.5 \
        pandas==1.5.3 \
        python-dateutil==2.9.0.post0 \
        pytz==2026.3.post1 \
        six==1.17.0 \
        BactInspectorMax==0.1.3
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/opt/bactinspector/bin:$PATH

%runscript
    exec /opt/bactinspector/bin/bactinspector "$@"

%test
    mash --version
    /opt/bactinspector/bin/bactinspector --version
    /opt/bactinspector/bin/bactinspector check_species -h >/dev/null
