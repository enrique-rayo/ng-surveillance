params {
    input = 'test_data'
    batch_name = null
    min_contig_length = 1000
    target_genus_taxid = 482
    target_species_taxid = 485
    qc_control_sample_pattern = null
    kraken2_db = null
    use_reassembly_for = []
    prokka_genus = null
    ariba_db = null
    pyngost_db = null
    pyngost_exclude_samples = null
    snippy_reference = null
    snippy_mask = null
    snippy_core_exclude_samples = null
    run_phylogeny = false
    run_assembly_mapped_snippy = false

    // Per-process resource tuning, values carried over from ng-pipeline's
    // production nextflow.config (chlamyvetpath: 121 GiB host RAM).
    spades_threads  = 16
    spades_mem      = 64
    quast_threads   = 8
    ariba_threads   = 1
    snippy_threads  = 16
    gubbins_threads = 32
}

profiles {
    local {
    }
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            withName: KRAKEN2 {
                cpus = 24
            }
            withName: /SPADES|SPADES_REASSEMBLY/ {
                cpus   = params.spades_threads
                memory = "${params.spades_mem} GB"
            }
            withName: /QUAST|QUAST_FILTERED|QUAST_REASSEMBLY/ {
                cpus = params.quast_threads
            }
            withName: ARIBA_RUN {
                cpus = params.ariba_threads
            }
            withName: /SNIPPY|SNIPPY_ASSEMBLY/ {
                cpus = params.snippy_threads
            }
            withName: GUBBINS {
                cpus = params.gubbins_threads
            }
        }
    }
}
